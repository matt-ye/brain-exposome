/* ── Result visuals: radar (category profile) + gauge (brain-age) — inline SVG, no deps ── */
let catView = 'radar';   // 'radar' | 'list'

/* brain-years attributable to each domain: λ·Σln(RR)/ln2·T_double (uncapped, per category) */
function domainYears(r) {
  const lnByCat = {};
  r.factors.forEach(f => { lnByCat[f.cat] = (lnByCat[f.cat] || 0) + Math.log(f.rr); });
  return CATS.map(([key]) => ({
    key, years: LAMBDA * (lnByCat[key] || 0) / Math.log(2) * r.tDouble,
    count: r.factors.filter(f => f.cat === key).length,
  }));
}
function applyCatView() {
  const radar = $('out-radar'), list = $('out-categories');
  if (radar) radar.style.display = catView === 'radar' ? '' : 'none';
  if (list) list.style.display = catView === 'list' ? '' : 'none';
  document.querySelectorAll('.cat-view-btn').forEach(b => b.classList.toggle('is-active', b.dataset.view === catView));
}
function renderRadar(r) {
  const el = $('out-radar');
  if (!el) return;
  const dom = domainYears(r), N = dom.length, cx = 150, cy = 140, R = 86;
  const vals = dom.map(d => Math.max(0, d.years));
  const niceMax = Math.max(2, Math.ceil(Math.max(...vals)));   // outer ring = whole years
  const pt = (i, frac) => {
    const a = (-90 + i * (360 / N)) * Math.PI / 180;
    return [cx + R * frac * Math.cos(a), cy + R * frac * Math.sin(a)];
  };
  const poly = pts => pts.map(p => p[0].toFixed(1) + ',' + p[1].toFixed(1)).join(' ');
  let grid = '';
  for (let k = 1; k <= 3; k++) grid += `<polygon class="radar-ring" points="${poly(dom.map((_, i) => pt(i, k / 3)))}"/>`;
  for (let i = 0; i < N; i++) { const [x, y] = pt(i, 1); grid += `<line class="radar-spoke" x1="${cx}" y1="${cy}" x2="${x.toFixed(1)}" y2="${y.toFixed(1)}"/>`; }
  const dpts = dom.map(d => pt(dom.indexOf(d), Math.min(1, Math.max(0, d.years) / niceMax)));
  const dataPoly = `<polygon class="radar-area" points="${poly(dpts)}"/>`;
  let marks = '', labels = '', valLabels = '';
  dom.forEach((d, i) => {
    const [dx, dy] = dpts[i];
    const nm = L(CAT_SHORT[d.key][0], CAT_SHORT[d.key][1]);
    const yv = Math.max(0, d.years);
    const tip = `${nm}: +${yv.toFixed(1)} ${L('年', 'yr')}` + (d.count ? `（${d.count}）` : '');
    marks += `<circle class="radar-hit" cx="${dx.toFixed(1)}" cy="${dy.toFixed(1)}" r="15"><title>${tip}</title></circle>`;
    marks += `<circle class="radar-dot" cx="${dx.toFixed(1)}" cy="${dy.toFixed(1)}" r="3.5"/>`;
    const [lx, ly] = pt(i, 1.28);
    const anchor = lx > cx + 6 ? 'start' : lx < cx - 6 ? 'end' : 'middle';
    labels += `<text class="radar-label" x="${lx.toFixed(1)}" y="${(ly + 3).toFixed(1)}" text-anchor="${anchor}">${nm}</text>`;
    // small "+x" value beside each non-zero data point
    if (yv >= 0.05) {
      const [vx, vy] = pt(i, Math.min(1, yv / niceMax) + 15 / R);
      const va = vx > cx + 6 ? 'start' : vx < cx - 6 ? 'end' : 'middle';
      valLabels += `<text class="radar-val" x="${vx.toFixed(1)}" y="${(vy + 3).toFixed(1)}" text-anchor="${va}">+${yv.toFixed(1)}</text>`;
    }
  });
  const scale = `<text class="radar-scale" x="4" y="14" text-anchor="start">${L('外圈', 'outer ring')} = +${niceMax} ${L('年', 'yr')}</text>`;
  const empty = r.count === 0 ? `<text class="radar-empty" x="${cx}" y="${cy + 4}" text-anchor="middle">${L('未偵測到可調整因子', 'no modifiable factors')}</text>` : '';
  el.innerHTML = `<svg viewBox="0 0 300 280" role="img" aria-label="${L('各面向風險雷達圖（腦齡年數）', 'risk radar by category (brain-years)')}">${grid}${dataPoly}${marks}${valLabels}${labels}${scale}${empty}</svg>`;
}
function renderGauge(r) {
  const el = $('out-gauge');
  if (!el) return;
  const GMAX = 12, t = Math.max(0, Math.min(1, r.dMid / GMAX));   // GMAX matches the ±12-yr cap
  const color = r.band === 'few' ? '#2fbf71' : r.band === 'several' ? '#f5a623' : '#e5484d';
  const cx = 100, cy = 104, rad = 82;
  const P = deg => [cx + rad * Math.cos(deg * Math.PI / 180), cy + rad * Math.sin(deg * Math.PI / 180)];
  const arc = (a0, a1) => {
    const [x0, y0] = P(a0), [x1, y1] = P(a1);
    return `M ${x0.toFixed(1)} ${y0.toFixed(1)} A ${rad} ${rad} 0 ${Math.abs(a1 - a0) > 180 ? 1 : 0} 1 ${x1.toFixed(1)} ${y1.toFixed(1)}`;
  };
  // The headline number lives INSIDE the arc (baseline just above the dial's flat edge).
  const num = `≈ +${r.dMid.toFixed(1)}`;
  el.innerHTML = `<svg viewBox="0 0 200 134" role="img" aria-label="${L('腦齡加速儀表', 'brain-age gauge')}">
    <path class="gauge-track" d="${arc(180, 360)}"/>
    <path class="gauge-val" d="${arc(180, 180 + 180 * t)}" style="stroke:${color}"/>
    <text class="gauge-num" x="100" y="96" text-anchor="middle">${num}</text>
    <text class="gauge-unit" x="100" y="118" text-anchor="middle">${L('年', 'years')}</text>
    <text class="gauge-tick" x="14" y="130" text-anchor="middle">0</text>
    <text class="gauge-tick" x="186" y="130" text-anchor="middle">${GMAX}+</text>
  </svg>`;
}

function renderResults(r) {
  // 1) categorical profile (LEAD)
  const profileEl = $('out-profile');
  const bandTxt = { few: L('少數', 'a few'), several: L('數項', 'several'), many: L('多項', 'many') }[r.band];
  const cls = r.band === 'few' ? 'ok' : r.band === 'several' ? 'warn' : 'bad';
  profileEl.className = 'result-profile ' + cls;
  profileEl.innerHTML = r.count === 0
    ? `${L('目前沒有偵測到可調整的風險因子 — 很好！', 'No modifiable risk factors detected — great!')}<span class="rp-sub">${L('持續維持這些好習慣。', 'Keep up these healthy habits.')}</span>`
    : `${L(`你目前有 ${r.count} 項可調整因子（${bandTxt}）。`, `You currently have ${r.count} modifiable factor${r.count > 1 ? 's' : ''} (${bandTxt}).`)}<span class="rp-sub">${L('針對這些因子採取行動，在族群層級與較低的失智風險相關。', 'Acting on these is associated with lower dementia risk at the population level.')}</span>`;

  // 2) brain-age gap (secondary, clearly educational) + a transparent derivation
  $('out-brainage').textContent = `≈ +${r.dMid.toFixed(1)} ${L('年', 'yr')}`;
  $('out-brainage-caption').textContent = L(
    `估計範圍 +${r.dLo.toFixed(1)} 到 +${r.dHi.toFixed(1)} 年${r.capped ? '（已達上限）' : ''}。這是教育性比喻，非影像量測的真實腦齡，也不是個人預測。`,
    `Estimated range +${r.dLo.toFixed(1)} to +${r.dHi.toFixed(1)} yr${r.capped ? ' (capped)' : ''}. An educational illustration — not a measured brain age, and not a personal prediction.`
  );
  const frows = r.factors.map(f => {
    const lab = FACTOR_LABELS[f.key] ? L(FACTOR_LABELS[f.key][0], FACTOR_LABELS[f.key][1]) : f.key;
    const extra = f.key === 'pm25' && r.meanPM != null ? `（${r.meanPM.toFixed(1)} µg/m³）` : '';
    return `<li>${lab}${extra} — RR ${f.rr.toFixed(2)}</li>`;
  }).join('');
  $('out-brainage-detail').innerHTML = `<details class="ba-detail"><summary>${L('如何算出這個數字？', 'How is this number derived?')}</summary><div class="ba-detail-body">
    <p>${L('納入計算的因子與其相對風險（RR，主要來自 2024 Lancet 委員會）：', 'Factors included and their relative risks (RR, mainly the 2024 Lancet Commission):')}</p>
    <ul class="ba-factors">${frows || `<li>${L('（目前沒有可調整因子）', '(no modifiable factors)')}</li>`}</ul>
    <ol class="ba-steps">
      <li>${L(`各因子 RR 相乘 → 原始合併 RR ≈ <strong>${r.rrProd.toFixed(2)}</strong>`, `Multiply the RRs → raw combined RR ≈ <strong>${r.rrProd.toFixed(2)}</strong>`)}</li>
      <li>${L(`乘上重疊縮減係數 λ = ${r.lambda}（因子彼此相關，直接相乘會高估；λ 近似 Lancet 委員會的 communality 調整）→ 有效 RR = 原始RR<sup>${r.lambda}</sup> ≈ <strong>${r.rrEff.toFixed(2)}</strong>`, `Apply overlap-shrinkage λ = ${r.lambda} (factors are correlated; multiplying raw RRs overstates risk — λ approximates the Commission's communality adjustment) → effective RR = rawRR<sup>${r.lambda}</sup> ≈ <strong>${r.rrEff.toFixed(2)}</strong>`)}</li>
      <li>${L(`換算成腦齡：log₂(有效 RR) × ${r.tDouble} ≈ <strong>+${r.dMid.toFixed(1)} 年</strong>${r.capped ? '（已達上限）' : ''}。失智風險每約 ${r.tDouble} 年翻倍，log₂ 把「風險倍數」換算成「相當於老了幾年」（上限約 ±12 年）。`, `Convert to brain-years: log₂(effective RR) × ${r.tDouble} ≈ <strong>+${r.dMid.toFixed(1)} yr</strong>${r.capped ? ' (capped)' : ''}. Dementia risk roughly doubles every ${r.tDouble} years; log₂ turns the risk multiple into "years older" (capped at about ±12 yr).`)}</li>
    </ol>
    <p class="ba-detail-note">${L('λ = 0.6 與 ±12 年上限是本工具為避免高估設的參數（非已發表常數）。這是教育性估計，非個人預測。', 'λ = 0.6 and the ±12-yr cap are this tool\'s parameters to avoid overstatement (not published constants). Educational estimate, not a personal prediction.')}</p>
  </div></details>`;

  // 3) by category
  const catCount = {};
  r.factors.forEach(f => { catCount[f.cat] = (catCount[f.cat] || 0) + 1; });
  $('out-categories').innerHTML = CATS.map(([key, zh, en]) => {
    const n = catCount[key] || 0;
    const badge = n === 0 ? '✅' : '⚠️';
    const sub = n === 0
      ? L('無明顯因子', 'no notable factor')
      : L(`${n} 項因子`, `${n} factor${n > 1 ? 's' : ''}`);
    return `<div class="stat-row">
      <div class="stat-row-label">
        <div class="stat-row-title">${L(zh, en)}</div>
        <div class="stat-row-sub">${sub}</div>
      </div>
      <div class="stat-row-num"><span class="cat-badge">${badge}</span></div>
    </div>`;
  }).join('');
  renderGauge(r);
  renderRadar(r);
  applyCatView();

  // 4) exposome / PM2.5 detail — WHO guideline → your annual avg → cumulative comparison → provenance
  const ex = $('out-exposome');
  if (r.res) {
    ex.style.display = '';
    const mult = (r.meanPM / PM_REF).toFixed(1);
    const yourCum = Math.round(r.res.dose);
    const whoCum = PM_REF * r.res.years;
    ex.innerHTML = L(
      `🌫️ <strong>WHO 建議年均 PM2.5 ≤ ${PM_REF} µg/m³。</strong><br>` +
      `你的時間加權年均暴露 ≈ <strong>${r.meanPM.toFixed(1)} µg/m³</strong>，約為 WHO 建議的 <strong>${mult}×</strong>。<br>` +
      `在約 ${r.res.years} 年的居住史中，你的估計累積暴露 ≈ <strong>${yourCum.toLocaleString()} µg/m³·年</strong>；` +
      `同樣年數下、符合 WHO 標準者僅 ${whoCum.toLocaleString()} µg/m³·年 —— 你約為其 <strong>${mult}×</strong>。<br>` +
      `<em>PM2.5 採用 ACAG 衛星逐年資料（V6.GL.03，1998–2024）；1998 年以前的居住年份沿用 1998 年數值估計。</em>`,
      `🌫️ <strong>WHO guideline: annual PM2.5 ≤ ${PM_REF} µg/m³.</strong><br>` +
      `Your time-weighted annual exposure ≈ <strong>${r.meanPM.toFixed(1)} µg/m³</strong>, about <strong>${mult}×</strong> the WHO guideline.<br>` +
      `Over ~${r.res.years} years of residence, your estimated cumulative exposure ≈ <strong>${yourCum.toLocaleString()} µg/m³·years</strong>; ` +
      `someone meeting the WHO guideline for the same span would be just ${whoCum.toLocaleString()} µg/m³·years — you are about <strong>${mult}×</strong> that.<br>` +
      `<em>PM2.5 uses ACAG satellite annual data (V6.GL.03, 1998–2024); residence years before 1998 reuse the 1998 value.</em>`
    );
  } else { ex.style.display = 'none'; }

  // 5) actions
  const seen = new Set();
  const items = r.factors.map(f => f.key).filter(k => { if (seen.has(k) || !ACTIONS[k]) return false; seen.add(k); return true; });
  const yourVal = (k) => {
    if (k === 'pm25' && r.meanPM != null) return `${r.meanPM.toFixed(1)} µg/m³`;
    if (k === 'ldl' && r.ldl) return `${r.ldl.num} ${r.ldl.unit === 'mmol' ? 'mmol/L' : 'mg/dL'}`;
    return '';
  };
  $('out-actions').innerHTML = items.length === 0
    ? `<li class="act-none">${L('沒有需要優先處理的可調整因子 — 繼續保持健康的生活型態與環境。', 'No priority modifiable factors — keep up a healthy lifestyle and environment.')}</li>`
    : items.map(k => {
        const a = ACTIONS[k], info = FACTOR_INFO[k];
        const name = FACTOR_LABELS[k] ? L(FACTOR_LABELS[k][0], FACTOR_LABELS[k][1]) : k;
        const you = yourVal(k);
        return `<li>
          <div class="act-head"><strong>${name}</strong>${you ? `<span class="act-you">${L('你的值', 'yours')}: ${you}</span>` : ''}</div>
          ${info ? `<div class="act-ref">${L(info[0], info[1])}</div>` : ''}
          ${info ? `<div class="act-why">${L(info[2], info[3])}</div>` : ''}
          <div class="act-do"><span class="act-cat">${L(a[0], a[1])}</span>${L(a[2], a[3])}</div>
        </li>`;
      }).join('');
}

/* ── Wizard navigation ── */
let currentStep = 1;
let lastResult = null;
const RESULT_STEP = 6;

/* Height of the sticky site header — anything we scroll to must clear it,
   otherwise the wizard stepper ends up hidden underneath. */
function headerOffset() {
  const h = document.querySelector('header');
  return (h ? h.getBoundingClientRect().height : 0) + 12;
}

/* Keep every step the same height as the tallest one, so moving between steps
   never resizes the page under the user's finger. Re-run on resize / lang change. */
function fitWizardHeight() {
  // Only the input steps are equalised; the results step is naturally long and is allowed to be.
  const steps = [...document.querySelectorAll('.wizard-step')].filter(s => +s.dataset.step !== RESULT_STEP);
  if (!steps.length) return;
  const active = steps.find(s => s.classList.contains('is-active'));
  steps.forEach(s => { s.style.minHeight = ''; });
  let max = 0;
  steps.forEach(s => {
    const wasActive = s.classList.contains('is-active');
    if (!wasActive) s.classList.add('is-active');
    max = Math.max(max, s.scrollHeight);
    if (!wasActive) s.classList.remove('is-active');
  });
  steps.forEach(s => { s.style.minHeight = max + 'px'; });
  if (active) active.classList.add('is-active');
}

function showStep(n) {
  currentStep = n;
  document.querySelectorAll('.wizard-step').forEach(s => s.classList.toggle('is-active', +s.dataset.step === n));
  document.querySelectorAll('.wizard-steps li').forEach(li => {
    const s = +li.dataset.step;
    li.classList.toggle('is-active', s === n);
    li.classList.toggle('is-done', s < n);
  });
  if (n === 2) renderResidences();   // re-derive the year range from the age just entered in Step 1
  if (n === RESULT_STEP) { lastResult = computeResult(); renderResults(lastResult); }
  // Keep the active step pill in view inside the horizontally-scrolling stepper.
  const pill = document.querySelector(`.wizard-steps li[data-step="${n}"]`);
  if (pill && pill.scrollIntoView) pill.scrollIntoView({ block: 'nearest', inline: 'nearest' });
  const wiz = document.querySelector('.wizard');
  if (wiz) window.scrollTo({ top: wiz.getBoundingClientRect().top + window.scrollY - headerOffset(), behavior: 'smooth' });
}

/* ── BMI from height+weight (Step 1) → auto-selects the body-weight option (Step 3).
     Taiwan cutoffs, matching that question's hint: 過重 24–27, 肥胖 ≥ 27. ── */
function bmiCategory(bmi) {
  if (bmi >= 27) return 'obese';
  if (bmi >= 24) return 'overweight';
  return 'normal';
}
function updateBmi() {
  const h = parseFloat(val('in-height')), w = parseFloat(val('in-weight'));
  const hint = $('bmi-hint'), sel = $('in-bmi');
  const okIn = Number.isFinite(h) && Number.isFinite(w) && h > 50 && w > 10;
  if (!okIn) {
    if (hint) hint.textContent = L('填了身高體重就會自動算 BMI，並帶入後面的體位選項（可自行修改）',
      "Enter height & weight and we'll compute your BMI and pre-fill the body-weight question (you can override it)");
    return;
  }
  const bmi = w / Math.pow(h / 100, 2);
  const cat = bmiCategory(bmi);
  const catTxt = { normal: L('正常或過輕', 'normal or under'), overweight: L('過重', 'overweight'), obese: L('肥胖', 'obese') }[cat];
  if (sel) sel.value = cat;                       // drive the Step-3 question; user can still override
  if (hint) hint.innerHTML = L(
    `BMI ≈ <span class="bmi-out">${bmi.toFixed(1)}</span>（${catTxt}）— 已自動帶入後面的體位選項，可自行修改`,
    `BMI ≈ <span class="bmi-out">${bmi.toFixed(1)}</span> (${catTxt}) — pre-filled the body-weight question below; you can override it`);
}

/* ── Intro tabs (story / privacy / disclaimer) — click to open, click the active one to close.
     The tab row never moves, so opening a panel can't reflow the buttons. ── */
let introOpen = null;
function showIntro(name) {
  const wrap = document.getElementById('intro-body-wrap');
  if (!wrap) return;
  introOpen = (introOpen === name) ? null : name;
  wrap.hidden = introOpen === null;
  wrap.querySelectorAll('.intro-body').forEach(p => { p.hidden = p.dataset.introPanel !== introOpen; });
  document.querySelectorAll('.it-btn').forEach(b => {
    const on = b.dataset.intro === introOpen;
    b.classList.toggle('is-active', on);
    b.setAttribute('aria-selected', on ? 'true' : 'false');
  });
}

/* ── Main tabs (check-in / map / references) ── */
let currentTab = 'calc';
function showTab(name) {
  currentTab = name;
  document.querySelectorAll('.tab-panel').forEach(p => p.classList.toggle('is-active', p.dataset.panel === name));
  document.querySelectorAll('.mt-btn').forEach(b => {
    const on = b.dataset.tab === name;
    b.classList.toggle('is-active', on);
    b.setAttribute('aria-selected', on ? 'true' : 'false');
  });
  if (name === 'calc') fitWizardHeight();
  // Leaflet/globe were sized while their panel was display:none (→ 0×0); re-measure on reveal.
  if (name === 'map') {
    setTimeout(() => {
      if (map && map.invalidateSize) { try { map.invalidateSize(); } catch (_) {} }
      try { gResize(); } catch (_) {}
    }, 60);
  }
  const tabs = document.getElementById('main-tabs');
  if (tabs) window.scrollTo({ top: tabs.getBoundingClientRect().top + window.scrollY - headerOffset(), behavior: 'smooth' });
}

/* ── Language re-render ── */
function applyOptionLangs() {
  const en = lang() === 'en';
  document.querySelectorAll('select option[data-en]').forEach(o => { o.textContent = en ? o.dataset.en : o.dataset.zh; });
  document.querySelectorAll('select optgroup[data-en]').forEach(g => { g.label = en ? g.dataset.en : g.dataset.zh; });
}

/* ── Choropleth map (Leaflet + topojson-client, vendored) — country switcher.
