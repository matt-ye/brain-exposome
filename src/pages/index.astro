---
import BaseLayout from '../layouts/BaseLayout.astro';
import T from '../components/T.astro';
import Tour from '../components/Tour.astro';
import provenance from '../../public/data/data-provenance.json';
import { dpTableHtml, makeRegionNamer } from '../lib/dp-table.mjs';
import { agingTables, agingSentence } from '../lib/aging-tables.mjs';
import { structuredData } from '../lib/dataset-ld.mjs';

/* Render the data tables at build time, not in the browser.
   The map stays client-side; these are the same numbers in a form crawlers and answer
   engines can read. The client script re-renders on tab / filter / language change. */
const regionName = makeRegionNamer();
const dpInitial = dpTableHtml(provenance, {
  type: 'aging',
  lang: 'zh',
  name: (iso) => regionName(iso, 'zh'),
});

const aging = agingTables('zh');
const AGING_TOP_N = 5;

/* Dataset / WebApplication / MedicalWebPage nodes, generated from the data files'
   own meta so they cannot drift from the data. */
const extraLd = structuredData();
---
<BaseLayout
  title="腦健康 Exposome 檢測 · Brain-Health Exposome Check-in"
  description="腦健康自我檢視工具：以 Lancet 2024 十四項可調整風險因子與 PM2.5 暴露估算腦齡加速，並收錄全球高齡化、認知退化與危險因子盛行率資料。純前端計算，資料不上傳。"
  extraLd={extraLd}
>
  <div class="container-wide calc-page">

    <!-- Hero -->
    <section class="calc-hero">
      <h1><T zh="腦健康 Exposome" en="Brain-Health Exposome" /> <span class="accent-text"><T zh="檢測" en="Check-in" /></span></h1>
      <p class="calc-tagline"><T
        zh="輸入你的居住史與基本資料，看看累積的環境暴露（exposome）對應到多少「相對腦齡加速」年數。純前端計算，資料不上傳。"
        en="Enter your residence history and basic profile to see how your accumulated exposome maps to a 'relative brain-aging' figure. Runs entirely in your browser — nothing is uploaded."
      /></p>

      <!-- Intro: three collapsible cards (story / privacy / disclaimer) — native <details>, no JS needed -->
      <div class="intro-tabs" id="intro-tabs" role="tablist" aria-label="about">
        <button type="button" class="it-btn" role="tab" aria-selected="false" data-intro="story"><span class="ic-icon">📖</span><T zh="這個工具的由來" en="Why this tool exists" /></button>
        <button type="button" class="it-btn" role="tab" aria-selected="false" data-intro="privacy"><span class="ic-icon">🔒</span><T zh="資料安全" en="Your data" /></button>
        <button type="button" class="it-btn" role="tab" aria-selected="false" data-intro="warn"><span class="ic-icon">⚠️</span><T zh="重要提醒" en="Important" /></button>
      </div>
      <div class="intro-body-wrap" id="intro-body-wrap" hidden>
        <div class="intro-body" data-intro-panel="story">
            <p><T
              zh="這個工具的起點，是我參與 2026 年阿茲海默症協會國際年會（AAIC）聽的其中一場演講主題：「為什麼每個人大腦老化的速度不一樣？」失智症的大腦病變往往在發病前 15–20 年就悄悄開始，而有些推動病變的因子就在生活中。講者分享的案例讓全場震撼，好幾位不到 60 歲、高學歷、沒有慢性病、生活型態健康的人卻確診阿茲海默症，而他們的共同點是長期住在空污嚴重的地區，腦影像顯示他們的大腦比實際年齡老了 15–25 歲。學者提出的論點是，這些環境中的危險因子推動著他們的大腦老化與病變。"
              en="This tool began with one of the talks I attended at the 2026 Alzheimer's Association International Conference (AAIC): “Why do our brains age at different speeds?” Dementia's brain changes often begin quietly 15–20 years before symptoms — and some of the factors driving them are woven into everyday life. The cases the speaker shared stunned the room: several people under 60, highly educated, with no chronic disease and healthy lifestyles, yet diagnosed with Alzheimer's — their common thread was living long-term in heavily polluted areas, with brain scans showing brains 15–25 years older than their actual age. The researchers' argument was that these environmental risk factors were driving their brain aging and pathology."
            /></p>
            <p><T
              zh="這場演講後，我認為「及早覺察危險因子」，是讓所有人能立刻採取行動預防失智症的基礎。所以，我把可用的證據彙整成一個可計算的模型：以《Lancet》失智症委員會的可調整危險因子、公開的 PM2.5 衛星資料，以及「風險大約每 5–6 年翻倍」等文獻為基礎，再逐步接上 GBD、NCD-RisC、WHO、World Bank 等公開資料庫，讓不同國家也能互相比較。"
              en="After that talk, I came to see noticing risk factors early as the foundation that lets anyone act right away to help prevent dementia. So I gathered the available evidence into a computable model — built on the Lancet Commission's modifiable risk factors, open satellite PM2.5 data, and findings such as risk roughly doubling every 5–6 years — then progressively wired in public databases (GBD, NCD-RisC, WHO, World Bank) so different countries can be compared."
            /></p>
            <p><T
              zh="使用者可以輸入歷年居住地與基本資料，看看自己累積的「exposome（環境暴露總和）」對應到多少『相對腦齡加速』年數；也能在全球地圖上瀏覽各國的失智盛行、空污、高齡化與可調控風險概況。它不是診斷、不是醫療器材，也不預測任何個人是否會失智——只希望讓我們對身邊這些「可以及早行動」的危險因子更有覺知。"
              en="You can enter your residence history and basic profile to see how your accumulated 'exposome' maps to a 'relative brain-aging' figure in years — and browse each country's dementia prevalence, air pollution, aging and modifiable-risk picture on the global map. It is not a diagnosis, not a medical device, and predicts nothing about any individual — it exists only to raise awareness of the risk factors around us that we can act on early."
            /></p>
        </div>
        <div class="intro-body" data-intro-panel="privacy" hidden>
            <p><T zh="所有計算都在你的瀏覽器內完成，資料不會上傳或儲存到任何伺服器。" en="All calculations run entirely in your browser — nothing is uploaded or stored on any server." /></p>
            <p><T zh="為了少填一步，第一段居住地的「國家」會依你目前的網路所在地或瀏覽器語系自動預設（不經第三方、不會索取定位權限），你可以隨時自行更改。" en="To save a step, the first residence's country is pre-filled from your current network location or browser locale (no third party, no location-permission prompt); you can change it anytime." /></p>
        </div>
        <div class="intro-body" data-intro-panel="warn" hidden>
            <p><T zh="本工具僅供一般健康教育與自我覺察之用，並非醫療器材、不是診斷或篩檢工具，無法預測任何人是否會罹患失智症。" en="This tool is for general health education and self-awareness only. It is not a medical device, not a diagnostic or screening test, and cannot predict whether anyone will develop dementia." /></p>
            <ul>
              <li><T zh="結果描述的是「族群層級」的關聯（來自已發表研究），而不是對「你個人」的預測；同樣的因子，每個人的結果差異其實很大。" en="Results describe population-level associations (from published research), not a prediction about you personally — individual outcomes vary a great deal." /></li>
              <li><T zh="這裡的「腦齡加速」是一個教育性的比喻數字，不是用腦部影像（MRI／EEG）量出來的真實腦齡。" en="The 'brain-age acceleration' here is an educational illustration, not a real brain age measured from imaging (MRI/EEG)." /></li>
              <li><T zh="本工具不能取代醫療專業判斷。如有任何健康疑慮，請諮詢合格的醫療人員。" en="This does not replace professional medical advice. Consult a qualified healthcare provider for any health concern." /></li>
              <li><T zh="PM2.5 採用 ACAG 衛星推估的逐年（1998–2024）縣市資料（1998 年以前的居住年份沿用 1998 值）。地圖上的失智盛行率為縣市層級的模型估計值，非實測。" en="PM2.5 uses ACAG satellite-derived annual (1998–2024) county data (residence years before 1998 reuse the 1998 value). The dementia prevalence on the map is a county-level modelled estimate, not measured." /></li>
          </ul>
        </div>
      </div>
    </section>

    <!-- Main tabs: keep the page short — one thing on screen at a time -->
    <nav class="main-tabs" id="main-tabs" role="tablist" aria-label="sections">
      <button type="button" class="mt-btn is-active" role="tab" aria-selected="true" data-tab="calc"><span class="mt-ico">📝</span><T zh="風險因子填寫" en="Your check-in" /></button>
      <button type="button" class="mt-btn" role="tab" aria-selected="false" data-tab="map"><span class="mt-ico">🌍</span><T zh="全球地圖" en="Global map" /></button>
      <button type="button" class="mt-btn" role="tab" aria-selected="false" data-tab="refs"><span class="mt-ico">📚</span><T zh="資料與文獻" en="Data & sources" /></button>
    </nav>

    <!-- ── Tab 1: personal check-in (wizard + method) ── -->
    <div class="tab-panel is-active" data-panel="calc">
    <h2 class="section-heading"><T zh="個人 14 項可調整失智症風險因子填寫" en="Enter your 14 modifiable dementia risk factors" /></h2>

    <!-- Wizard -->
    <div class="wizard">
      <ol class="wizard-steps" id="wizard-steps">
        <li data-step="1" class="is-active"><span class="wz-dot">1</span><span class="wz-lbl"><T zh="基本資料" en="About you" /></span></li>
        <li data-step="2"><span class="wz-dot">2</span><span class="wz-lbl"><T zh="居住史" en="Places" /></span></li>
        <li data-step="3"><span class="wz-dot">3</span><span class="wz-lbl"><T zh="心血管代謝" en="Cardiometabolic" /></span></li>
        <li data-step="4"><span class="wz-dot">4</span><span class="wz-lbl"><T zh="感官・心理" en="Senses & mood" /></span></li>
        <li data-step="5"><span class="wz-dot">5</span><span class="wz-lbl"><T zh="生活型態" en="Lifestyle" /></span></li>
        <li data-step="6"><span class="wz-dot">6</span><span class="wz-lbl"><T zh="結果" en="Results" /></span></li>
      </ol>

      <!-- Step 1 — About you -->
      <section class="wizard-step is-active" data-step="1">
        <h2 class="section-heading">1. <T zh="關於你" en="About you" /></h2>
        <div class="calc-form-card">
          <div class="form-grid">
            <label class="form-field">
              <span><T zh="年齡" en="Age (years)" /></span>
              <input type="number" id="in-age" value="50" min="18" max="100" step="1" />
            </label>
            <label class="form-field">
              <span><T zh="生理性別" en="Sex" /></span>
              <select id="in-sex">
                <option value="female" data-zh="女性" data-en="Female">女性</option>
                <option value="male" data-zh="男性" data-en="Male">男性</option>
              </select>
            </label>
            <label class="form-field">
              <span><T zh="身高" en="Height" /> <em>(cm)</em></span>
              <input type="number" id="in-height" placeholder="165" min="120" max="220" step="0.5" />
            </label>
            <label class="form-field">
              <span><T zh="體重" en="Weight" /> <em>(kg)</em></span>
              <input type="number" id="in-weight" placeholder="60" min="25" max="250" step="0.5" />
              <small class="field-hint" id="bmi-hint"><T zh="填了身高體重就會自動算 BMI，並帶入後面的體位選項（可自行修改）" en="Enter height & weight and we'll compute your BMI and pre-fill the body-weight question (you can override it)" /></small>
            </label>
            <label class="form-field">
              <span><T zh="教育程度" en="Education" /> <em><T zh="（認知存量）" en="(cognitive reserve)" /></em></span>
              <select id="in-education">
                <option value="tertiary" data-zh="大專以上" data-en="Tertiary or above">大專以上</option>
                <option value="secondary" data-zh="高中職" data-en="Secondary (high school)">高中職</option>
                <option value="primary" data-zh="國中以下" data-en="Primary or less">國中以下</option>
              </select>
              <small class="field-hint"><T zh="指早年正規教育年數；只有「國中以下」才計為風險。終身學習也能累積認知存量" en="Early-life schooling; only 'primary or less' counts as a risk. Lifelong learning also builds reserve" /></small>
            </label>
          </div>
        </div>
        <div class="wizard-nav">
          <span></span>
          <button type="button" class="wz-btn wz-next" data-goto="2"><T zh="下一步 →" en="Next →" /></button>
        </div>
      </section>

      <!-- Step 2 — Places -->
      <section class="wizard-step" data-step="2">
        <h2 class="section-heading">2. <T zh="你住過的地方" en="Places you've lived" /></h2>
        <p class="calc-section-desc">
          <T zh="加入你人生各階段主要居住的縣市與大約年份。系統會用該地區的年均 PM2.5 估算你「時間加權」的長期空氣污染暴露。年份可粗估即可。" en="Add the main counties you've lived in across life, with rough years. We estimate your time-weighted long-term PM2.5 exposure from each area's annual mean. Approximate years are fine." />
        </p>
        <div class="supp-table-wrap">
          <table class="supp-table res-table">
            <colgroup>
              <col class="col-drag" />
              <col class="col-country" />
              <col class="col-region" />
              <col class="col-year" />
              <col class="col-year" />
              <col class="col-pm" />
              <col class="col-del" />
            </colgroup>
            <thead>
              <tr>
                <th></th>
                <th><T zh="國家" en="Country" /></th>
                <th><T zh="地區" en="Region" /></th>
                <th><T zh="從" en="From" /></th>
                <th><T zh="到" en="To" /></th>
                <th>PM2.5</th>
                <th></th>
              </tr>
            </thead>
            <tbody id="res-grid"></tbody>
          </table>
        </div>
        <p class="res-hint"><T zh="⠿ 可上下拖曳調整居住順序（年份區間留在原位，只換地點）。" en="⠿ Drag rows to reorder where you lived (the time slots stay put — only the places move)." /></p>
        <div class="res-controls">
          <div class="res-add-group">
            <button type="button" class="wz-btn wz-ghost" id="res-add-first">↑ <T zh="更早的居住地" en="Earlier place" /></button>
            <button type="button" class="wz-btn wz-ghost" id="res-add-last">↓ <T zh="更近期的居住地" en="Later place" /></button>
          </div>
          <p class="res-summary" id="res-summary"></p>
        </div>
        <div class="wizard-nav">
          <button type="button" class="wz-btn wz-back" data-goto="1">← <T zh="上一步" en="Back" /></button>
          <button type="button" class="wz-btn wz-next" data-goto="3"><T zh="下一步 →" en="Next →" /></button>
        </div>
      </section>

      <!-- Step 3 — Cardiometabolic -->
      <section class="wizard-step" data-step="3">
        <h2 class="section-heading">3. <T zh="心血管與代謝" en="Heart & metabolic" /></h2>
        <p class="calc-section-desc"><T zh="不確定就選「不確定」，不會被算成風險。這些對應到 Lancet 委員會可調整的失智風險因子。" en="Pick 'Not sure' if you don't know — it won't be counted as a risk. These map to the Lancet Commission's modifiable dementia risk factors." /></p>

        <div class="calc-form-card">
          <h3 class="calc-subheading"><T zh="❤️ 心血管代謝" en="❤️ Cardiometabolic" /></h3>
          <div class="form-grid">
            <label class="form-field">
              <span><T zh="高血壓" en="Hypertension" /></span>
              <select id="in-htn">
                <option value="no" data-zh="沒有" data-en="No">沒有</option>
                <option value="yes" data-zh="有" data-en="Yes">有</option>
                <option value="unknown" data-zh="不確定" data-en="Not sure">不確定</option>
              </select>
              <small class="field-hint"><T zh="經診斷高血壓，或血壓 ≥ 140/90 mmHg（中年高血壓與失智關聯最強）" en="Diagnosed, or BP ≥ 140/90 mmHg (midlife hypertension matters most)" /></small>
            </label>
            <label class="form-field">
              <span><T zh="糖尿病" en="Diabetes" /></span>
              <select id="in-diabetes">
                <option value="no" data-zh="沒有" data-en="No">沒有</option>
                <option value="yes" data-zh="有" data-en="Yes">有</option>
                <option value="unknown" data-zh="不確定" data-en="Not sure">不確定</option>
              </select>
              <small class="field-hint"><T zh="經診斷，或 HbA1c ≥ 6.5% / 空腹血糖 ≥ 126 mg/dL" en="Diagnosed, or HbA1c ≥ 6.5% / fasting glucose ≥ 126 mg/dL" /></small>
            </label>
            <label class="form-field">
              <span><T zh="體位（BMI）" en="Body weight (BMI)" /></span>
              <select id="in-bmi">
                <option value="normal" data-zh="正常或過輕" data-en="Normal or under">正常或過輕</option>
                <option value="overweight" data-zh="過重" data-en="Overweight">過重</option>
                <option value="obese" data-zh="肥胖（BMI ≥ 30）" data-en="Obese (BMI ≥ 30)">肥胖（BMI ≥ 30）</option>
                <option value="unknown" data-zh="不確定" data-en="Not sure">不確定</option>
              </select>
              <small class="field-hint"><T zh="台灣：過重 BMI 24–27、肥胖 ≥ 27（國際肥胖為 ≥ 30）。中年肥胖較相關" en="Overweight BMI 24–27, obese ≥ 27 (Taiwan); ≥ 30 is the international obesity cutoff" /></small>
            </label>
            <label class="form-field">
              <span><T zh="膽固醇（LDL 高不高）" en="Cholesterol (is LDL high)" /></span>
              <select id="in-cholesterol">
                <option value="normal" data-zh="正常或不確定" data-en="Normal or unsure">正常或不確定</option>
                <option value="high" data-zh="LDL 偏高" data-en="High LDL">LDL 偏高</option>
              </select>
              <small class="field-hint"><T zh="不知道數值就用這裡；建議 LDL < 130 mg/dL" en="Use this if you don't know your number; aim for LDL < 130 mg/dL" /></small>
            </label>
            <label class="form-field">
              <span><T zh="LDL 數值（選填，更精準）" en="LDL value (optional, more precise)" /></span>
              <div class="ldl-row">
                <input type="number" id="in-ldl" placeholder="130" min="40" max="300" step="1" />
                <select id="in-ldl-unit" class="ldl-unit">
                  <option value="mgdl" data-zh="mg/dL" data-en="mg/dL">mg/dL</option>
                  <option value="mmol" data-zh="mmol/L" data-en="mmol/L">mmol/L</option>
                </select>
              </div>
              <small class="field-hint"><T zh="建議 < 130 mg/dL（≈ 3.36 mmol/L）；心血管高風險者目標更低。台灣／美國檢驗單多為 mg/dL" en="Aim for < 130 mg/dL (≈ 3.36 mmol/L); lower if high cardiovascular risk. TW/US labs report mg/dL" /></small>
            </label>
            <label class="form-field">
              <span><T zh="身體活動" en="Physical activity" /></span>
              <select id="in-inactive">
                <option value="active" data-zh="每週規律運動" data-en="Regularly active">每週規律運動</option>
                <option value="inactive" data-zh="很少運動" data-en="Rarely active">很少運動</option>
              </select>
              <small class="field-hint"><T zh="「規律」≈ 每週 ≥ 150 分鐘中等強度（如快走）。低於此算很少運動" en="'Regular' ≈ ≥ 150 min/week moderate (e.g. brisk walking); below that counts as rarely active" /></small>
            </label>
          </div>
        </div>

        <div class="wizard-nav">
          <button type="button" class="wz-btn wz-back" data-goto="2">← <T zh="上一步" en="Back" /></button>
          <button type="button" class="wz-btn wz-next" data-goto="4"><T zh="下一步 →" en="Next →" /></button>
        </div>
      </section>

      <!-- Step 4 — Senses, mood & social -->
      <section class="wizard-step" data-step="4">
        <h2 class="section-heading">4. <T zh="感官・心理・社交" en="Senses, mood & social" /></h2>
        <p class="calc-section-desc"><T zh="不確定就選「不確定」，不會被算成風險。" en="Pick 'Not sure' if you don't know — it won't be counted as a risk." /></p>

        <div class="calc-form-card">
          <h3 class="calc-subheading"><T zh="👂 感官" en="👂 Sensory" /></h3>
          <div class="form-grid">
            <label class="form-field">
              <span><T zh="聽力損失" en="Hearing loss" /></span>
              <select id="in-hearing">
                <option value="none" data-zh="沒有" data-en="No">沒有</option>
                <option value="untreated" data-zh="有，未使用助聽器" data-en="Yes, untreated">有，未使用助聽器</option>
                <option value="treated" data-zh="有，已矯治／戴助聽器" data-en="Yes, treated / aids">有，已矯治／戴助聽器</option>
                <option value="unknown" data-zh="不確定" data-en="Not sure">不確定</option>
              </select>
              <small class="field-hint"><T zh="「未矯治」= 聽得吃力／需調大音量但沒戴助聽器。矯治後風險大幅下降" en="'Untreated' = struggle to hear but no hearing aid. Treating it lowers the risk a lot" /></small>
            </label>
            <label class="form-field">
              <span><T zh="視力損失" en="Vision loss" /></span>
              <select id="in-vision">
                <option value="none" data-zh="沒有" data-en="No">沒有</option>
                <option value="untreated" data-zh="有，未矯治" data-en="Yes, untreated">有，未矯治</option>
