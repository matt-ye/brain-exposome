  .result-brainage :global(.ba-detail-body) { margin-top: 0.7rem; color: var(--color-text-muted); line-height: 1.6; background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-sm); padding: 0.8rem 1rem; }
  .result-brainage :global(.ba-detail-body strong) { color: var(--color-text); }
