const AGE_TIERS = [['未達高齡化 <7%', 'Pre-aging <7%'], ['高齡化社會 7–14%', 'Aging 7–14%'],
  ['高齡社會 14–20%', 'Aged 14–20%'], ['超高齡社會 ≥20%', 'Super-aged ≥20%']];
// MCI (mild cognitive impairment) — a FEW strong-data countries only, on its own scale. Heterogeneous
// (age band / criteria / survey year differ) so a distinct teal ramp signals "not the risk layers,
// not cross-country comparable"; the method box lists each country's source + criteria.
const MCI_BINS = [5, 10, 14, 18, 22];
const MCI_RAMP = ['#f0f9f7', '#cfe8e1', '#9fd2c6', '#66b3a3', '#2f8f7d', '#116b5c'];
// SCD (subjective cognitive decline) — self-report, wildly heterogeneous (7–76%); own scale, distinct
// violet ramp so it never reads as a comparable clinical layer.
const SCD_BINS = [15, 25, 35, 45, 55];
const SCD_RAMP = ['#f7f4f9', '#e2d4ec', '#c8a6d8', '#a678bf', '#8248a0', '#5c2483'];
const WORLD_METRICS = {
  pm25: { prop: 'pm25', bins: PM_BINS, unit: 'µg/m³', zh: 'PM2.5 µg/m³', en: 'PM2.5 µg/m³', dec: 1 },
  composite: { prop: 'paf', bins: PAF_COMPOSITE.bins, unit: '%', zh: PAF_COMPOSITE.legendZh, en: PAF_COMPOSITE.legendEn, dec: 1 },
  aging: { prop: 'pop65', bins: AGE_BINS, ramp: AGE_RAMP, tiers: AGE_TIERS, unit: '%', zh: '高齡人口 65+ %', en: 'Population 65+ %', dec: 1 },
  // national dementia prevalence among 60+ (GBD 2023) — cross-country comparable, one shade per country
  prevalence: { prop: 'prev', bins: PREV_60.bins, unit: '%', zh: '失智盛行率 60+ %（GBD）', en: 'Dementia 60+ % (GBD)', dec: 1 },
  // MCI national estimate — a few strong-data countries, own scale, NOT cross-comparable (see method box)
  mci: { prop: 'mci', bins: MCI_BINS, ramp: MCI_RAMP, unit: '%', zh: 'MCI 盛行率 %（國家別估計）', en: 'MCI % (national estimate)', dec: 1 },
  // SCD national self-report — own scale, NOT comparable (see method box)
  scd: { prop: 'scd', bins: SCD_BINS, ramp: SCD_RAMP, unit: '%', zh: 'SCD 盛行率 %（自述、部分國）', en: 'SCD % (self-report, few)', dec: 1 },
};
// Single-factor PAF on the globe: read the per-country baked values — props.fac[k].f (PAF, colour)
// and .p (national prevalence, tooltip). Uses the same PAF_FACTOR bins/ramp as the flat maps.
for (const _k of EXPO_FACTORS) {
  WORLD_METRICS[_k] = {
    factor: _k, bins: PAF_FACTOR.bins, unit: '%', dec: 1,
    zh: FACTOR_LABEL[_k][0] + ' PAF %', en: FACTOR_LABEL[_k][1] + ' PAF %',
    get: p => (p.fac && p.fac[_k]) ? p.fac[_k].f : null,
    prevGet: p => (p.fac && p.fac[_k]) ? p.fac[_k].p : null,
  };
}
function gMetric() { return WORLD_METRICS[mapMode] || WORLD_METRICS.pm25; }
function gTheme(dark, light) { return document.documentElement.getAttribute('data-theme') === 'dark' ? dark : light; }
function gColor(v, bins, ramp) {
  if (v == null || Number.isNaN(v)) return gTheme('#2b3050', '#e6e6e6');
  const R = ramp || RAMP;
  let i = 0; while (i < bins.length && v > bins[i]) i++;
  return R[i];
}
function gResize() {
  if (!gcanvas) return;
  const r = $('globe-stage').getBoundingClientRect();
  gW = r.width; gH = r.height;
  const dpr = Math.min(window.devicePixelRatio || 1, 2);
  gcanvas.width = gW * dpr; gcanvas.height = gH * dpr;
  gcanvas.style.width = gW + 'px'; gcanvas.style.height = gH + 'px';
  gctx.setTransform(dpr, 0, 0, dpr, 0, 0);
  gproj.fitExtent([[16, 16], [gW - 16, gH - 16]], { type: 'Sphere' });
  gBaseScale = gproj.scale();           // fitted scale = zoom 1×; the slider multiplies this
  gproj.scale(gBaseScale * gZoom);
  gDraw();
}
function gSetZoom(factor) {   // factor 1..4 (globe); reapply around the current (centered) translate
  gZoom = factor;
  if (gBaseScale) { gproj.scale(gBaseScale * gZoom); gDraw(); }
}
function gDraw() {
  if (!gW || !worldGeo) return;
  gctx.clearRect(0, 0, gW, gH);
  gctx.beginPath(); gpath({ type: 'Sphere' }); gctx.fillStyle = gTheme('#0b0d18', '#eef3fb'); gctx.fill();
  gctx.beginPath(); gpath(ggrat); gctx.strokeStyle = gTheme('rgba(255,255,255,.05)', 'rgba(0,0,0,.05)'); gctx.lineWidth = 0.5; gctx.stroke();
  const m = gMetric();
  for (const f of worldGeo) {
    gctx.beginPath(); gpath(f);
    const gv = m.get ? m.get(f.properties) : f.properties[m.prop];
    gctx.fillStyle = gColor(gv, m.bins, m.ramp); gctx.fill();
    gctx.lineWidth = f === ghover ? 1.3 : 0.4;
    gctx.strokeStyle = f === ghover ? gTheme('#fff', '#111') : gTheme('#2a2f4a', '#fff');
    gctx.stroke();
  }
  gctx.beginPath(); gpath({ type: 'Sphere' }); gctx.strokeStyle = gTheme('#3a4066', '#c9d4e6'); gctx.lineWidth = 1; gctx.stroke();
}
function gTickLoop() {
  graf = requestAnimationFrame(gTickLoop);
  if (gspin && !gdrag && inWorld()) { grot[0] += 0.16; gproj.rotate(grot); gDraw(); }
}
function gLegendBuild() {
  const el = $('globe-legend'); if (!el) return;
  const m = gMetric(), bins = m.bins, ramp = m.ramp || RAMP, rows = [];
  if (m.tiers) {                                   // named tiers (aging society)
    for (let i = 0; i < ramp.length; i++)
      rows.push(`<span class="lg-row"><i style="background:${ramp[i]}"></i>${L(m.tiers[i][0], m.tiers[i][1])}</span>`);
  } else {                                         // numeric ranges
    const edges = [0, ...bins];
    for (let i = 0; i < ramp.length; i++) {
      const lab = bins[i] != null ? `${edges[i]}–${bins[i]}` : `>${edges[edges.length - 1]}`;
      rows.push(`<span class="lg-row"><i style="background:${ramp[i]}"></i>${lab}</span>`);
    }
  }
  el.innerHTML = `<div class="lg-title">${L(m.zh, m.en)}</div>` + rows.join('');
}
function ccOfFeature(f) { const iso = (f.properties.iso_a2 || '').toLowerCase(); return MAP_CFG[iso] ? iso : null; }
function gFeatureAt(clientX, clientY) {
  const rect = gcanvas.getBoundingClientRect();
  const p = gproj.invert([clientX - rect.left, clientY - rect.top]);
  if (!p || !Number.isFinite(p[0])) return null;
  for (const f of worldGeo) if (window.d3.geoContains(f, p)) return f;
  return null;
}
function gPointerMove(e) {
  if (gdrag && gLast) {
    const k = 0.3;
    grot[0] += (e.clientX - gLast[0]) * k;
    grot[1] = Math.max(-90, Math.min(90, grot[1] - (e.clientY - gLast[1]) * k));
    gLast = [e.clientX, e.clientY];
    gproj.rotate(grot); gDraw();
    return;
  }
  const found = gFeatureAt(e.clientX, e.clientY);
  if (found !== ghover) { ghover = found; gDraw(); }
  const tip = $('globe-tip'), rect = gcanvas.getBoundingClientRect();
  if (found) {
    const m = gMetric(), v = m.get ? m.get(found.properties) : found.properties[m.prop], drill = ccOfFeature(found);
    const cc2 = (found.properties.iso_a2 || '').toLowerCase();
    let core;
    if (mapMode === 'mci' || mapMode === 'scd') {
      core = cogTip(cc2, mapMode, found.properties.name);   // value + age band + diagnosis/instrument marker
    } else if (m.factor) {                                  // single risk factor: show prevalence + PAF
      const pv = m.prevGet ? m.prevGet(found.properties) : null;
      core = `<b>${found.properties.name}</b><br>${L(m.zh, m.en)}: `
        + (v == null ? L('無資料', 'no data')
                     : `${(+v).toFixed(m.dec)}%<br><span style="opacity:.7">${L('盛行率', 'prevalence')} ${pv != null ? pv + '%' : '—'}</span>`);
    } else {
      core = `<b>${found.properties.name}</b><br>${L(m.zh, m.en)}: ` + (v == null ? L('無資料', 'no data') : `${(+v).toFixed(m.dec)} ${m.unit}`);
    }
    tip.innerHTML = core + (drill ? `<br><span style="opacity:.7">${L('點擊看行政區細節', 'click for admin-1 detail')}</span>` : '');
    tip.hidden = false;
    tip.style.left = Math.min(gW - 160, e.clientX - rect.left + 12) + 'px';
    tip.style.top = (e.clientY - rect.top + 12) + 'px';
  } else { tip.hidden = true; }
}
function setupGlobe() {
  if (gcanvas) return;
  gcanvas = $('map-globe'); gctx = gcanvas.getContext('2d');
  gproj = window.d3.geoOrthographic().precision(0.5);
  gpath = window.d3.geoPath(gproj, gctx);
  ggrat = window.d3.geoGraticule10();
  gproj.rotate(grot);
  // Pointer handlers live on the canvas (not the stage) so overlay controls — the spin
  // button, legend, tooltip — never trigger a drag or drill.
  gcanvas.addEventListener('pointerdown', (e) => {
    gdrag = true; gspin = false; updateSpinBtn(); gDownXY = [e.clientX, e.clientY]; gLast = [e.clientX, e.clientY];
    try { gcanvas.setPointerCapture(e.pointerId); } catch (x) { /* ignore */ }
  });
  gcanvas.addEventListener('pointermove', gPointerMove);
  gcanvas.addEventListener('pointerup', (e) => {
    gdrag = false;
    const moved = gDownXY ? Math.hypot(e.clientX - gDownXY[0], e.clientY - gDownXY[1]) : 99;
    gLast = null; gDownXY = null;
    if (moved < 5) {   // a tap, not a drag → drill down
      const f = gFeatureAt(e.clientX, e.clientY), cc = f && ccOfFeature(f);
      if (cc) { const cs = $('map-country'); if (cs) cs.value = cc; selectView(cc); }
    }
  });
  gcanvas.addEventListener('pointerleave', () => { ghover = null; const t = $('globe-tip'); if (t) t.hidden = true; });
  const spinBtn = $('globe-spin');
  if (spinBtn) spinBtn.addEventListener('click', () => { gspin = !gspin; updateSpinBtn(); });
  window.addEventListener('resize', () => { if (inWorld()) gResize(); });
  new MutationObserver(() => { if (inWorld()) gDraw(); })
    .observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
}
async function enterWorld() {
  mapCountry = 'world';
  if (mapMode !== 'pm25' && mapMode !== 'composite') mapMode = 'pm25';
  const mapEl = $('map'), stage = $('globe-stage');
  if (mapEl) mapEl.hidden = true;
  if (stage) stage.hidden = false;
  gZoom = 1; gspin = true;                       // fresh globe view: reset zoom, resume auto-spin
  const zslider = $('map-zoom'); if (zslider) zslider.value = 0;
  if (!worldGeo) {
    const g = await fetch('/data/geo/world-globe.geojson').then(r => r.ok ? r.json() : null).catch(() => null);
    worldGeo = g ? g.features : [];
    setupGlobe();
  }
  gResize(); gLegendBuild(); updateSpinBtn();
  if (!graf) gTickLoop();
  syncModeButtons(); renderMethodBox();
}
function selectView(v) {
  if (v === 'world') { enterWorld(); return; }
  const stage = $('globe-stage'), mapEl = $('map');
  if (stage) stage.hidden = true;
  if (mapEl) mapEl.hidden = false;
  if (map) map.invalidateSize();   // re-read size now #map is visible again, before fitBounds
  drawCountry(v);
}
async function initMap() {
  const el = $('map');
  if (!el || !window.L || !window.topojson) return;
  try {
    map = window.L.map(el, { scrollWheelZoom: false, attributionControl: true });
    map.attributionControl.setPrefix(false).addAttribution(
      L('界線 © NLSC／taiwan-atlas · Natural Earth｜PM2.5 © ACAG｜失智盛行率為模型估計值',
        'Boundaries © NLSC/taiwan-atlas · Natural Earth · PM2.5 © ACAG · dementia = modelled estimate'));
    EXPOSOME = await fetch('/data/exposome/exposome.json').then(r => r.ok ? r.json() : null).then(d => d && d.countries).catch(() => null);
    MCI_NAT = await fetch('/data/mci/mci-national.json').then(r => r.ok ? r.json() : null).then(d => d && d.countries).catch(() => null);
    SCD_NAT = await fetch('/data/scd/scd-national.json').then(r => r.ok ? r.json() : null).then(d => d && d.countries).catch(() => null);
    // Aging (Tier 0): national 65+ % per country from the globe dataset (World Bank; MOI for TW), keyed by
    // lower-case ISO-2. Applied uniformly to every admin-1 unit until real sub-national data lands (Tier 1/2).
    AGING_NAT = await fetch('/data/geo/world-globe.geojson').then(r => r.ok ? r.json() : null).then(g => {
      if (!g) return null;
      const m = {};
      for (const f of g.features) { const cc = (f.properties.iso_a2 || '').toLowerCase(); if (cc && f.properties.pop65 != null) m[cc] = f.properties.pop65; }
      return m;
    }).catch(() => null);
    // Default landing = the global globe overview (marquee view; the country switcher's
    // first option). Drilling into a country lazily builds its Leaflet admin-1 map.
    await enterWorld();
    document.querySelectorAll('.map-btn').forEach(b => b.addEventListener('click', () => {
      if (b.disabled) return;
      mapMode = b.dataset.mode;
      if (inWorld()) { gLegendBuild(); gDraw(); syncModeButtons(); renderMethodBox(); }
      else applyMode();
    }));
    const fsel = $('map-factor');   // single-factor PAF picker: works on the globe and in a country's admin-1 map
    if (fsel) fsel.addEventListener('change', () => {
      if (!fsel.value) return;
      mapMode = fsel.value;
      if (inWorld()) { gLegendBuild(); gDraw(); syncModeButtons(); renderMethodBox(); }
      else applyMode();
    });
    const cs = $('map-country');
    if (cs) cs.addEventListener('change', () => selectView(cs.value));
    const zoom = $('map-zoom');   // universal zoom: drives the globe's scale or Leaflet's zoom
    if (zoom) zoom.addEventListener('input', () => {
      const v = +zoom.value;
      if (inWorld()) gSetZoom(1 + v / 100 * 3);                                     // globe 1×–4×
      else if (map && leafFitZoom != null) map.setZoom(leafFitZoom + v / 100 * 5);  // Leaflet fit .. fit+5
    });
    map.on('zoomend', () => {   // keep the slider in sync when Leaflet's own +/- buttons are used
      if (inWorld() || leafFitZoom == null) return;
      const z = $('map-zoom'); if (z) z.value = Math.max(0, Math.min(100, (map.getZoom() - leafFitZoom) / 5 * 100));
    });
  } catch (e) {
    console.error('map init failed:', e);
    el.innerHTML = `<p class="map-fail">${L('地圖資料載入失敗。', 'Map data failed to load.')}</p>`;
  }
}
function relabelMap() {
  if (inWorld()) { gLegendBuild(); renderMethodBox(); updateSpinBtn(); gDraw(); }
  else if (map && geoLayer) applyMode();
}

/* ── Init ── */
/* LDL unit: mg/dL (default) vs mmol/L — update the input's range/placeholder, and
   convert the typed value when the unit changes so the number stays meaningful. */
const LDL_MMOL_COUNTRIES = new Set(['GB', 'HK', 'AU', 'NZ', 'CA', 'IE']);
function applyLdlUnit() {
  const sel = $('in-ldl-unit'), inp = $('in-ldl');
  if (!sel || !inp) return;
  if (sel.value === 'mmol') { inp.min = '1'; inp.max = '8'; inp.step = '0.1'; inp.placeholder = '3.4'; }
  else { inp.min = '40'; inp.max = '300'; inp.step = '1'; inp.placeholder = '130'; }
}
function onLdlUnitChange() {
  const sel = $('in-ldl-unit'), inp = $('in-ldl');
  const v = parseFloat(inp.value);
  if (!isNaN(v) && v > 0) {   // sel.value is the NEW unit → convert from the old one
    inp.value = sel.value === 'mmol' ? (v * LDL_MGDL_TO_MMOL).toFixed(2) : String(Math.round(v / LDL_MGDL_TO_MMOL));
  }
  applyLdlUnit();
}

/* ── Data-provenance / coverage table (tabs = data type, rows = every country) ── */
/* Markup comes from src/lib/dp-table.mjs — the same function the build used to render
   the initial table, so the two can't drift. */
let DP = null, dpType = 'aging', dpOnlyData = false;
const _dpName = makeRegionNamer();
function dpName(iso) { return _dpName(iso, lang()); }
function renderDpTable() {
  if (!DP) return;
  const { html, count } = dpTableHtml(DP, {
    type: dpType,
    lang: lang(),
    name: dpName,
    filter: $('dp-filter') ? $('dp-filter').value : '',
    onlyData: dpOnlyData,
  });
  $('dp-table-wrap').innerHTML = html;
  const cnt = $('dp-count'); if (cnt) cnt.textContent = `${count} ${L('個國家/地區', 'countries/areas')}`;
}
function renderProvenance() {
  if (!DP) return;
  $('dp-tabs').innerHTML = DP.types.map(t =>
    `<button type="button" class="dp-tab${t.key === dpType ? ' is-active' : ''}" data-key="${t.key}">${L(t.zh, t.en)}</button>`).join('');
  const f = $('dp-filter'); if (f) f.placeholder = L('篩選國家…', 'Filter countries…');
  renderDpTable();
}
async function setupProvenance() {
  DP = await fetch('/data/data-provenance.json').then(r => r.ok ? r.json() : null).catch(() => null);
  if (!DP) return;
  const tabs = $('dp-tabs');
  if (tabs) tabs.addEventListener('click', e => { const b = e.target.closest('[data-key]'); if (!b) return; dpType = b.dataset.key; renderProvenance(); });
  const f = $('dp-filter'); if (f) f.addEventListener('input', renderDpTable);
  const oc = $('dp-only-data'); if (oc) oc.addEventListener('change', () => { dpOnlyData = oc.checked; renderDpTable(); });
  renderProvenance();
}

async function init() {
  document.querySelectorAll('[data-goto]').forEach(b => b.addEventListener('click', () => showStep(+b.dataset.goto)));
  document.querySelectorAll('.wizard-steps li').forEach(li => {
    li.setAttribute('role', 'button');
    li.setAttribute('tabindex', '0');
    const go = () => showStep(+li.dataset.step);
    li.addEventListener('click', go);
    li.addEventListener('keydown', e => {
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); go(); }
    });
  });
  document.querySelectorAll('.cat-view-btn').forEach(b => b.addEventListener('click', () => { catView = b.dataset.view; applyCatView(); }));
  const addFirst = $('res-add-first');
  if (addFirst) addFirst.addEventListener('click', () => insertResidence(0, 'above'));
  const addLast = $('res-add-last');
  if (addLast) addLast.addEventListener('click', () => insertResidence(residences.length - 1, 'below'));
  // main tabs
  const tabs = $('main-tabs');
  if (tabs) tabs.addEventListener('click', e => {
    const b = e.target.closest('[data-tab]'); if (!b) return;
    showTab(b.dataset.tab);
  });
  const itabs = $('intro-tabs');
  if (itabs) itabs.addEventListener('click', e => {
    const b = e.target.closest('[data-intro]'); if (!b) return;
    showIntro(b.dataset.intro);
  });
  // Re-derive the residence year range whenever the age changes (Step 1 feeds Step 2's timeline).
  const ageIn = $('in-age');
  if (ageIn) ageIn.addEventListener('change', renderResidences);
  ['in-height', 'in-weight'].forEach(id => {
    const el = $(id);
    if (el) { el.addEventListener('input', updateBmi); el.addEventListener('change', updateBmi); }
  });
  // load real PM2.5 — Taiwan county series + world country series (ACAG) — plus geo-detect, in parallel
  let detectedIso = null;
  try {
    const [cty, world, iso] = await Promise.all([
      fetch('/data/pm25/tw-county-pm25.json').then(r => r.json()),
      fetch('/data/pm25/world-country-pm25.json').then(r => r.json()).catch(() => null),
      detectCountryIso().catch(() => null),
    ]);
    COUNTY_PM = cty;
    COUNTY_LIST = Object.entries(COUNTY_PM.counties)
      .map(([code, c]) => [code, c.name, c.nameEn])
      .sort((a, b) => a[1].localeCompare(b[1], 'zh-Hant'));
    WORLD_PM = world;
    detectedIso = iso;
  } catch (e) { COUNTY_LIST = FALLBACK_COUNTIES.slice(); }
  buildCountryList();
  // Soft-default the first residence to the visitor's country (overridable; only the untouched default row).
  const detectedCountry = isoToCountryValue(detectedIso);
  if (detectedCountry && detectedCountry !== residences[0].country) {
    residences[0].country = detectedCountry;
    if (detectedCountry !== 'TW') residences[0].place = '';  // non-TW rows show "nationwide"; place unused
  }
  if (residences[0].country === 'TW' && !COUNTY_LIST.some(c => c[0] === residences[0].place)) {
    residences[0].place = (COUNTY_LIST[0] || ['63000'])[0];
  }
  // LDL unit: default to mmol/L for countries that report it, else mg/dL; wire the toggle.
  const ldlUnitSel = $('in-ldl-unit');
  if (ldlUnitSel) {
    if (detectedIso && LDL_MMOL_COUNTRIES.has(String(detectedIso).toUpperCase())) ldlUnitSel.value = 'mmol';
    ldlUnitSel.addEventListener('change', onLdlUnitChange);
    applyLdlUnit();
  }

  applyOptionLangs();
  renderResidences();
  fitWizardHeight();
  window.addEventListener('langchange', () => {
    applyOptionLangs();
    renderResidences();
    if (currentStep === RESULT_STEP && lastResult) renderResults(lastResult);
    relabelMap();
    renderProvenance();
    fitWizardHeight();
  });
  let _rz;
  window.addEventListener('resize', () => { clearTimeout(_rz); _rz = setTimeout(fitWizardHeight, 150); });
  initMap();
  setupProvenance();
}
init();
</script>
