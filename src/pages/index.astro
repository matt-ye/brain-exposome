    <!-- Admin-1 "population aged 65+" figures, rendered at build time.
         Same numbers the map draws; here as text so crawlers and answer engines can cite
         them. Top-N is visible; the full list sits in a <details> so it stays in the HTML
         without costing first-paint layout. -->
    <section class="calc-section calc-aging-tables">
      <h2 class="section-heading"><T zh="各國省縣級高齡化數據（65 歲以上人口占比）" en="Sub-national population aged 65+, by country" /></h2>
      <p class="calc-section-desc"><T
        zh="地圖上的每一個省縣級數字，在這裡以文字列出，每筆都標明來源與年份。展開「完整列表」可看該國全部行政區。"
        en="Every sub-national figure on the map, listed as text with its source and year. Expand “Full list” for all units in a country."
      /></p>

      {aging.map((c) => (
        <div class="ag-country" id={`aging-${c.cc}`}>
          <h3 class="ag-country-name">{c.country} <span class="ag-unit-count">({c.units.length})</span></h3>
          <p class="ag-stat"><T zh={agingSentence(c, 'zh')} en={agingSentence(c, 'en')} /></p>
          <table class="ag-table ag-table-top">
            <caption class="visually-hidden">{c.country} — {c.meta.metric}, {c.meta.year}</caption>
            <thead>
              <tr>
                <th scope="col"><T zh="行政區" en="Unit" /></th>
                <th scope="col"><T zh="65 歲以上占比" en="Share aged 65+" /></th>
              </tr>
            </thead>
            <tbody>
              {c.units.slice(0, AGING_TOP_N).map((u) => (
                <tr>
                  <th scope="row">
                    {u.nameLocal === u.name ? u.name : <T zh={u.nameLocal} en={u.name} />}
                    {!u.named && <span class="ag-unnamed" title={u.code}><T zh="（來源代碼，地名未確認）" en="(source code; name unverified)" /></span>}
                  </th>
                  <td>{u.pct}%</td>
                </tr>
              ))}
            </tbody>
          </table>
          {c.units.length > AGING_TOP_N && (
            <details class="ag-details">
              <summary><T zh="完整列表" en="Full list" /> ({c.units.length})</summary>
              <table class="ag-table">
                <caption class="visually-hidden">{c.country} — {c.meta.metric}, {c.meta.year} (all units)</caption>
                <thead>
                  <tr>
                    <th scope="col"><T zh="行政區" en="Unit" /></th>
                    <th scope="col"><T zh="65 歲以上占比" en="Share aged 65+" /></th>
                  </tr>
                </thead>
                <tbody>
                  {c.units.map((u) => (
                    <tr>
                      <th scope="row">
                        {u.nameLocal === u.name ? u.name : <T zh={u.nameLocal} en={u.name} />}
                        {!u.named && <span class="ag-unnamed" title={u.code}><T zh="（來源代碼，地名未確認）" en="(source code; name unverified)" /></span>}
                      </th>
                      <td>{u.pct}%</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </details>
          )}
          <p class="ag-source">
            <T zh={`來源：${c.meta.source}（${c.meta.year} 年）`} en={`Source: ${c.meta.source} (${c.meta.year})`} />
            {c.unnamed > 0 && (
              <T
                zh={`　※ ${c.unnamed} 個單元在地理檔中沒有對應圖形，僅列出來源代碼。`}
                en={`　※ ${c.unnamed} unit(s) have no matching shape in the geo file and are listed by source code only.`}
              />
            )}
          </p>
        </div>
      ))}
    </section>

